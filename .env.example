# Copy this file to .env.local or .env and replace with your real keys
# Vite picks up variables prefixed with VITE_

VITE_RAZORPAY_KEY=rzp_test_your_key_here
# For production use the live key (rzp_live_...)
# NOTE: Do NOT commit real secret keys. Create orders server-side using your Razorpay secret and expose only the public key to the frontend.

# Optional: Backend endpoint to create Razorpay orders (recommended)
# e.g., /api/create-order
VITE_CREATE_ORDER_ENDPOINT=/api/create-order
